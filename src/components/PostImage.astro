---
import { Picture } from "astro:assets";
const { src, alt, caption } = Astro.props;
---

<div class="flex flex-col items-center">
  <Picture src={src} alt={alt} layout="constrained" formats={["webp"]} />
  {
    caption && (
      <figcaption class="text-center text-gray-500 italic !-mt-4 !mb-4 !p-0">
        {caption}
      </figcaption>
    )
  }
</div>
