---
import "@fontsource-variable/m-plus-2/index.css";
import "../styles/global.css";
import BareLayout from "./BareLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const { title } = Astro.props;
const siteName = "Kao's Page";
---

<BareLayout
  title={`${title} | ${siteName}`}
  socialTitle={title}
  htmlClass="dark"
  bodyClass="max-w-4xl mx-auto px-10 bg-zinc-200 dark:bg-zinc-900 text-zinc-500 dark:text-zinc-300"
>
  <Header />
  <div class="mx-auto max-w-3xl">
    <slot />
  </div>
  <Footer />
</BareLayout>
